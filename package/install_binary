# Install the flat payload produced by the root `make stage` target.
set -euo pipefail
package_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

if [[ ${1:-} == --help ]]; then
    echo 'Install PXF server into PXF_HOME (defaults to $GPHOME/pxf).'
    echo 'Set GPHOME to also install both extensions into Cloudberry.'
    exit 0
fi
if [[ -z ${GPHOME:-} && -z ${PXF_HOME:-} ]]; then
    echo 'Set GPHOME or PXF_HOME before installing PXF.' >&2
    exit 1
fi
if [[ -n ${GPHOME:-} && ! -x $GPHOME/bin/pg_config ]]; then
    echo "GPHOME must point to a Cloudberry installation: $GPHOME" >&2
    exit 1
fi
PXF_HOME=${PXF_HOME:-$GPHOME/pxf}
mkdir -p "$PXF_HOME"
if [[ $(cd "$PXF_HOME" && pwd) == "$package_dir" ]]; then
    echo 'Extract the package outside the target PXF_HOME directory.' >&2
    exit 1
fi

atomic_install() {
    local artifact=$1 destination=$2 mode=$3 temporary
    temporary=$(mktemp "$destination/.pxf-install.XXXXXX")
    trap 'rm -f "$temporary"' EXIT
    install -m "$mode" "$artifact" "$temporary"
    mv -f "$temporary" "$destination/$(basename "$artifact")"
    trap - EXIT
}

# Keep the bundled extension directories for deployment to other cluster hosts.
# Overlay the server payload without deleting local configuration or old libraries.
for artifact in "$package_dir"/*; do
    [[ $(basename "$artifact") == install_component ]] && continue
    case $(basename "$artifact") in
        gpextable|fdw)
            destination="$PXF_HOME/$(basename "$artifact")"
            mkdir -p "$destination"
            for bundled in "$artifact"/*; do
                mode=644
                [[ $bundled == *.so ]] && mode=755
                atomic_install "$bundled" "$destination" "$mode"
            done
            ;;
        *) cp -a "$artifact" "$PXF_HOME/" ;;
    esac
done

if [[ -n ${GPHOME:-} ]]; then
    libdir=$("$GPHOME/bin/pg_config" --pkglibdir)
    sqldir=$("$GPHOME/bin/pg_config" --sharedir)/extension
    mkdir -p "$libdir" "$sqldir"
    for module in gpextable fdw; do
        [[ -d $package_dir/$module ]] || continue
        for artifact in "$package_dir/$module"/*.so "$package_dir/$module"/*.control "$package_dir/$module"/*.sql; do
            destination=$sqldir
            mode=644
            if [[ $artifact == *.so ]]; then destination=$libdir; mode=755; fi
            # Preserve inodes of libraries already mapped by existing backends.
            atomic_install "$artifact" "$destination" "$mode"
        done
    done
fi
printf 'Installed PXF %s into %s\n' "$(cat "$package_dir/version")" "$PXF_HOME"
